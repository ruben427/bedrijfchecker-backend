# Kopieer dit bestand naar .env voor lokaal draaien (Railway zet deze als
# environment variables in het project, geen .env-bestand nodig in productie).

# Postgres connection string. Railway geeft deze automatisch als je een
# Postgres-service aan het project toevoegt (variabele DATABASE_URL).
DATABASE_URL=postgres://user:password@localhost:5432/bedrijfchecker

# Anthropic API-key (console.anthropic.com / platform.claude.com -> API keys).
ANTHROPIC_API_KEY=sk-ant-...

# Welk model de audit-pipeline gebruikt. Pas aan zodra er een nieuwere
# modelversie beschikbaar is.
ANTHROPIC_MODEL=claude-sonnet-5

# Tavily API-key (tavily.com -> dashboard -> API keys).
TAVILY_API_KEY=tvly-...

# Poort waarop de server luistert. Railway zet deze zelf via PORT.
PORT=3000

# Komma-gescheiden lijst van origins die de frontend mag gebruiken om de API
# aan te roepen (CORS). Bijv. https://bedrijfchecker.jouwdomein.nl
ALLOWED_ORIGINS=*
