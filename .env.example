# Kopieer dit bestand naar .env voor lokaal draaien (Railway zet deze als
# environment variables in het project, geen .env-bestand nodig in productie).

# Postgres connection string. Railway geeft deze automatisch als je een
# Postgres-service aan het project toevoegt (variabele DATABASE_URL).
DATABASE_URL=postgres://user:password@localhost:5432/bedrijfchecker

# Anthropic API-key (console.anthropic.com / platform.claude.com -> API keys).
ANTHROPIC_API_KEY=sk-ant-...

# Welk model de audit-pipeline gebruikt. Pas aan zodra er een nieuwere
# modelversie beschikbaar is.
ANTHROPIC_MODEL=claude-sonnet-5

# Tavily API-key (tavily.com -> dashboard -> API keys).
TAVILY_API_KEY=tvly-...

# Poort waarop de server luistert. Railway zet deze zelf via PORT.
PORT=3000

# Komma-gescheiden lijst van origins die de frontend mag gebruiken om de API
# aan te roepen (CORS). Bijv. https://bedrijfchecker.jouwdomein.nl
ALLOWED_ORIGINS=*

# --- Toegang en misbruikbestendiging (fase 0, 14 sep) ---
# Volledige toegang tot alle cases + de audit trace. Zonder deze waarde zijn
# cases van vóór de eigenaarsmigratie niet meer opvraagbaar. Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# --- De MCP-server (/mcp, /mcp/v2, /mcp/v3, ...) ---
# Twee tokens, twee rollen. Ze staan los van ADMIN_TOKEN: dat is de HTTP-kant.
# Genereer elk met een eigen waarde:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Volledige toegang: alle achttien tools, inclusief uploaden, resolveren en
# het afvinken van signalen.
COA_STAFF_TOKEN=
#
# De redactierol: kijken, oordelen over labs en naamkoppelingen, en teksten
# redigeren. Dertien van de achttien tools; het binnenhalen en verifieren van
# bewijs zit er niet in. Leeg laten betekent simpelweg dat er geen
# redactietoken bestaat en niemand met die rol binnenkomt.
COA_REDACTIE_TOKEN=

# LET OP bij het koppelen van een connector: de client onthoudt de toollijst
# bij de URL waarop de connector is AANGEMAAKT en ververst die niet bij opnieuw
# verbinden. Komt er een tool bij, of verandert een keuzelijst in een tool, maak
# de connector dan aan op een pad dat die client nog nooit heeft gezien -
# /mcp/v4, /mcp/v5. Elk pad onder /mcp werkt en wijst naar dezelfde server.

# Rate limiting. Een audit kost meerdere betaalde AI-calls, dus het startlimiet
# is bewust laag. Leeg laten = de defaults hieronder.
RATE_LIMIT_AUDITS_PER_HOUR=10
RATE_LIMIT_ACTIONS_PER_10MIN=30
RATE_LIMIT_READS_PER_MIN=120
